<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only Material 3 theme. -->
    <style name="Theme.Sdkintegrationguide" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sign3_primary</item>
        <item name="colorOnPrimary">@color/sign3_on_primary</item>
        <item name="colorPrimaryContainer">@color/sign3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sign3_on_primary_container</item>
        <item name="colorSecondary">@color/sign3_secondary</item>
        <item name="colorSecondaryContainer">@color/sign3_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/sign3_on_primary_container</item>
        <item name="colorSurfaceContainerHigh">@color/sign3_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/sign3_primary_container</item>
        <item name="android:colorBackground">@color/sign3_surface</item>
        <item name="colorSurface">@color/sign3_surface</item>
        <item name="colorSurfaceContainer">@color/sign3_surface_container</item>
        <item name="colorOnSurface">@color/sign3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/sign3_on_surface_variant</item>
        <item name="colorOutline">@color/sign3_outline</item>
        <item name="android:statusBarColor">@color/sign3_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sign3_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Widget.Sign3.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/sign3_primary</item>
        <item name="titleTextColor">@color/sign3_on_primary</item>
        <item name="subtitleTextColor">@color/sign3_primary_container</item>
        <item name="navigationIconTint">@color/sign3_on_primary</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark</item>
    </style>

    <style name="Widget.Sign3.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/sign3_surface_container</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="TextAppearance.Sign3.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/sign3_on_surface</item>
    </style>

    <style name="TextAppearance.Sign3.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/sign3_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Sign3.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/sign3_on_surface</item>
    </style>
</resources>
