<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by Sign3 SDK -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional: location data in the intelligence response (geoSpoofed, gpsLocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Optional: sim affinity signals -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sdkintegrationguide">


        <activity
            android:name=".GetIntelligenceActivity"
            android:exported="true"
            android:label="@string/title_get_intelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UpdateOptionsActivity"
            android:exported="false"
            android:label="@string/title_update_options"
            android:parentActivityName=".GetIntelligenceActivity" />

        <activity
            android:name=".BehaviouralActivity"
            android:exported="false"
            android:label="@string/title_behavioural"
            android:parentActivityName=".GetIntelligenceActivity" />

        <activity
            android:name=".ScreenCaptureActivity"
            android:exported="false"
            android:label="@string/title_screen_capture"
            android:parentActivityName=".GetIntelligenceActivity" />
    </application>

</manifest>
